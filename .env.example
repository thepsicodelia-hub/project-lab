# Only the PUBLIC key. Never put service_role, sb_secret or database passwords here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable after enabling Email provider in Supabase. The free built-in sender is rate-limited;
# custom SMTP is optional later for higher delivery volume.
VITE_EMAIL_AUTH_ENABLED=false
# Enable after configuring Google OAuth in Supabase.
VITE_GOOGLE_AUTH_ENABLED=false
